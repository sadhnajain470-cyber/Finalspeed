# Copy this file to .env, then set DATABASE_URL from Supabase Connect.
# Local/direct connection (may be IPv6-only):
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres
# On IPv4-only hosting such as Render, set DATABASE_POOLER_URL to the full
# Session pooler URL copied from Supabase Dashboard > Connect > Session pooler.
# DATABASE_POOLER_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres
FLASK_SECRET_KEY=replace-this-with-a-long-random-secret
